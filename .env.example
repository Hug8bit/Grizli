# ── GRIZLI environment variables ─────────────────────────────────────────────
# Copy to .env and fill in real values (never commit .env)

# DataSF API base URL (default is the public endpoint, no key required)
DATASF_BASE_URL=https://data.sfgov.org/resource

# Directory where trained ML models are persisted
MODEL_DIR=models

# FastAPI server
API_HOST=0.0.0.0
API_PORT=8000

# Origins allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Streamlit (legacy app)
STREAMLIT_SERVER_PORT=8501
